---
import HomePage from '../../components/HomePage.astro';
import { locales, languageInfo, type Locale } from '../../i18n';
export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'pt-BR')
    .map((locale) => ({
      params: { lang: languageInfo[locale].path },
      props: { locale },
    }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<HomePage locale={locale} />
