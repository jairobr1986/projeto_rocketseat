---
import SEO from '../components/SEO.astro';
import { getMessages, type LocalizedProps } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props extends LocalizedProps {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { locale = 'pt-BR' } = Astro.props;
const t = getMessages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...Astro.props} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('jbr-theme');
        if (theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      {t.skip}
    </a>
    <slot />
  </body>
</html>
