---
import { whatsappFor, getMessages, type LocalizedProps } from '../i18n';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import SocialLinks from './SocialLinks.astro';
type Props = LocalizedProps;
const { locale = 'pt-BR' } = Astro.props;
const t = getMessages(locale);
---

<section
  id="sobre"
  class="section container about-section"
  aria-labelledby="about-title"
>
  <div class="about-visual" aria-hidden="true">
    <span>{t.aboutVisual}</span>
    <div class="about-monogram">
      &lt;/&gt;<span>↗</span>
    </div>
    <div class="about-visual-bottom">
      <span>
        <Lines text={t.aboutMotto} />
      </span>
      <span>JBR1986</span>
    </div>
  </div>
  <div class="about-copy">
    <p class="eyebrow">{t.aboutEyebrow}</p>
    <h2 id="about-title">
      <Lines text={t.aboutTitle} />
    </h2>
    {t.aboutParagraphs.map((p) => (
      <p>{p}</p>
    ))}
    <a
      class="text-link"
      href={whatsappFor(locale)}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.aboutLink}
      <Icon name="diagonal" size={20} />
    </a>
    <div class="about-socials">
      <SocialLinks locale={locale} label={t.connect} />
    </div>
  </div>
</section>
