---
import { whatsappFor, getMessages, type LocalizedProps } from '../i18n';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
type Props = LocalizedProps;
const { locale = 'pt-BR' } = Astro.props;
const t = getMessages(locale);
const whatsapp = whatsappFor(locale);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot"></span>
      {t.heroEyebrow}
    </p>
    <h1 id="hero-title">
      {t.heroTitle[0]}
      <br />
      {t.heroTitle[1]}
      <br />
      <span class="accent-text">{t.heroTitle[2]}</span>
    </h1>
    <p class="hero-description">{t.heroDescription}</p>
    <div class="hero-buttons">
      <a
        class="button"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" size={21} />
        {t.quote}
        <Icon name="diagonal" size={19} />
      </a>
      <a class="text-link" href="#projetos">
        {t.explore}
        <Icon name="arrow" size={19} />
      </a>
    </div>
    <div class="hero-socials">
      <SocialLinks locale={locale} label={t.follow} />
    </div>
  </div>
  <div class="tech-art" role="img" aria-label={t.artLabel}>
    <div class="tech-orbit"></div>
    <div class="tech-browser">
      <div class="tech-bar">
        <span class="window-dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>JBR1986 / DIGITAL EXPERIENCE</span>
        <span>↗</span>
      </div>
      <div class="tech-nav">
        <b>&lt;/&gt; JBR1986</b>
        <span>{t.artNav}</span>
      </div>
      <div class="tech-screen">
        <div>
          <span class="tech-kicker">{t.artKicker}</span>
          <strong>
            {t.artTitle[0]}
            <br />
            {t.artTitle[1]}
            <br />
            <em>{t.artTitle[2]}</em>
          </strong>
          <span class="tech-cta">{t.artStart} ↗</span>
        </div>
        <div class="code-symbol">
          &lt;/&gt;<span>{t.brandSubtitle}</span>
        </div>
      </div>
      <div class="tech-tiles">
        {t.artTiles.map((tile, i) => (
          <span>
            <Icon name={['window', 'spark', 'target'][i]} size={18} />
            {tile}
          </span>
        ))}
      </div>
    </div>
    <div class="tech-phone">
      <div class="tech-notch"></div>
      <b>&lt;/&gt; JBR1986</b>
      <small>{t.artPhoneCaption}</small>
      <strong>
        {t.artPhoneTitle[0]}
        <br />
        {t.artPhoneTitle[1]}
        <br />
        <em>{t.artPhoneTitle[2]}</em>
      </strong>
      <div class="phone-code">&lt;/&gt;</div>
      <span>{t.talk} ↗</span>
    </div>
    <div class="tech-badge">
      <Icon name="check" size={17} />
      {t.artBadge}
    </div>
    <span class="tech-caption">{t.artCaption} · JBR1986</span>
  </div>
</section>
<div class="principles">
  <div class="container principles-inner">
    <span>{t.principlesIntro}</span>
    {t.principles.map((item, i) => (
      <strong>
        <Icon name={['window', 'spark', 'target'][i]} size={18} />
        {item}
      </strong>
    ))}
  </div>
</div>
