---
import { getMessages, type LocalizedProps } from '../i18n';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { Image } from 'astro:assets';
import annaBella from '../assets/anna-bella.webp';
type Props = LocalizedProps;
const { locale = 'pt-BR' } = Astro.props;
const t = getMessages(locale);
---

<section
  id="projetos"
  class="projects-section section"
  aria-labelledby="projects-title"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.projectsEyebrow}</p>
        <h2 id="projects-title">
          <Lines text={t.projectsTitle} />
        </h2>
      </div>
      <p>
        <Lines text={t.projectsIntro} />
      </p>
    </div>
    <div class="projects-grid">
      {t.projects.map((project, index) => (
        <article class="project-card">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-art-link"
            aria-label={`${t.openProject} ${project.title} ${t.newTab}`}
          >
            <div class:list={['project-art', project.type]} aria-hidden="true">
              {project.type === 'editorial' && (
                <Image
                  class="editorial-photo"
                  src={annaBella}
                  alt=""
                  widths={[400, 600, 900]}
                  sizes="(max-width: 760px) calc(100vw - 40px), 380px"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="project-label">
                {t.study} {String(index + 1).padStart(2, '0')}
              </span>
              {project.type === 'museum' ? (
                <div class="museum-visual">
                  <small>{t.museumCaption}</small>
                  <strong>
                    MUSEU
                    <br />
                    NACIONAL<span>↗</span>
                  </strong>
                  <div class="museum-columns">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
              ) : project.type === 'editorial' ? (
                <div class="editorial-visual">
                  <small>{t.modelCaption}</small>
                  <strong>
                    Anna
                    <br />
                    <em>Bella.</em>
                  </strong>
                  <span>{t.modelNote}</span>
                </div>
              ) : (
                <div class="game-visual">
                  <small>{t.gameCaption}</small>
                  <span class="game-number">?</span>
                  <strong>
                    Lucky Number<span>{t.play} ↗</span>
                  </strong>
                </div>
              )}
              <span class="project-art-note">{t.cover}</span>
              <span class="project-open">
                <Icon name="diagonal" />
              </span>
            </div>
          </a>
          <div class="project-meta">
            <span>{project.category}</span>
            <span>{t.studyProject}</span>
          </div>
          <h3>
            <a href={project.url} target="_blank" rel="noopener noreferrer">
              {project.title}
              <Icon name="diagonal" size={22} />
            </a>
          </h3>
          <p>{project.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
